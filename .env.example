# Environment Mode
NODE_ENV=production

# Server Port (automatically assigned by Render/hosting platforms)
PORT=3000

# MongoDB Atlas Connection URI
MONGODB_URI=

# JWT Secret Key for Session Authentication
JWT_SECRET=

# Optional Gemini API Key
GEMINI_API_KEY=

# Optional Configurable CORS Allowed Origin
CORS_ORIGIN=

# Optional Frontend API Base URL (leave empty for single-service deployment)
VITE_API_URL=
